{
  "name": "claude-lifetime",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:assets": "node scripts/prepare-pglite-assets.mjs && node scripts/build-migrations.mjs && node scripts/build-collector.mjs",
    "predev": "npm run prepare:assets",
    "dev": "next dev",
    "prebuild": "npm run prepare:assets",
    "build": "next build",
    "preview": "node scripts/serve-static.mjs ../.. 4173",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p .",
    "pretest": "node scripts/build-migrations.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migration": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --script",
    "build:collector": "node scripts/build-collector.mjs",
    "publish:site": "npm run build && node scripts/publish-site.mjs",
    "test:e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "motion": "^14.11.1",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fflate": "^0.8.3",
    "prisma": "^7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
